{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-md-8">
                <h5 class="mb-3">Informations personnelles</h5>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Pseudonyme :</div>
                    <div class="col-sm-8">{{ user.pseudo }}</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 fw-bold">Email :</div>
                    <div class="col-sm-8">
                        <i class="fas fa-envelope me-2 text-muted"></i>
                        {{ user.email }}
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('user_edit') }}" class="btn btn-primary">

                        Modifier mon profil
                    </a>

                    <a href="{{ path('user_change_password') }}" class="btn btn-warning">

                        Changer mon mot de passe
                    </a>

                    <a href="{{ path('app_home') }}" class="btn btn-info">
                        Retour à l'accueil
                    </a>
                </div>
            </div>
        </div>
        <hr class="my-4">
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="mb-3">Mes posts récents</h5>
                {% for post in userPosts %}
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <h6 class="card-title">
                                <a href="#" class="text-decoration-none text-dark post-toggle" data-bs-toggle="collapse" data-bs-target="#post-{{ post.id }}" aria-expanded="false">
                                    {{ post.title }}
                                </a>
                            </h6>
                            <p class="mb-2 text-muted small">
                                Publié le {{ post.createdAt|date('d/m/Y H:i') }}
                            </p>
                            <span class="badge bg-secondary">
                                {{ post.comments|length }} {{ post.comments|length == 1 ? 'commentaire' : 'commentaires' }}
                            </span>

                            <div class="collapse mt-3" id="post-{{ post.id }}">
                                <div class="border-top pt-3">
                                    <div class="post-content mb-3 p-3 bg-light rounded">
                                        {{ post.content|nl2br }}
                                    </div>
                                    <h6 class="mb-3">Commentaires :</h6>
                                    {% for comment in post.comments %}
                                        <div class="comment-item mb-2 p-2 border-start border-3 border-primary">
                                            <small class="text-muted">
                                                Par <strong>{{ comment.user.pseudo }}</strong> —
                                                {{ comment.createdAt|date('d/m/Y H:i') }}
                                            </small>
                                            <div class="mt-1">{{ comment.content }}</div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-comment me-2"></i>
                                Mes commentaires récents
                            </h5>
                            {% if totalMessages > 10 %}
                                <small class="text-muted">{{ userMessage|length }} sur {{ totalMessages }}</small>
                            {% endif %}
                        </div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                {% for comment in userMessage %}
                                    <div class="list-group-item border-0 px-0">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="mb-2">
                                                    {{ comment.content|length > 150 ? comment.content|slice(0, 150) ~ '...' : comment.content }}
                                                </div>
                                                <small class="text-muted">
                                                    {% if comment.post %}
                                                        Sur le post : <strong><a href="{{ path('app_post_show', { id: comment.post.id }) }}">{{ comment.post.title }}</a></strong> —
                                                    {% endif %}
                                                    {{ comment.createdAt|date('d/m/Y H:i') }}
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
