{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau sujet{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Créer un nouveau sujet</h1>

        {{ form_start(form) }}

        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {attr: {'class': 'form-control'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.content) }}
            {{ form_widget(form.content, {attr: {'class': 'form-control', rows: 8}}) }}
            {{ form_errors(form.content) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.board) }}
            {{ form_widget(form.board, {attr: {'class': 'form-select'}}) }}
            {{ form_errors(form.board) }}
        </div>

        <button type="submit" class="btn btn-primary">Publier</button>

        {{ form_end(form) }}
    </div>
{% endblock %}
