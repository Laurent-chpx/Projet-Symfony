{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">📰 Derniers sujets</h1>
            <a href="{{ path('app_post_create') }}" class="btn btn-primary">Créer un nouveau sujet</a>
        </div>

        {% if posts is not empty %}
            <div class="row row-cols-1 row-cols-md-2 g-4">
                {% for post in posts %}
                    <div class="col">
                        <div class="card shadow-sm h-100">
                            <div class="card-body">
                                <h5 class="card-title">{{ post.title }}</h5>
                                <p class="card-text">{{ post.content|striptags|slice(0, 150) ~ '...' }}</p>
                            </div>
                            <div class="card-footer d-flex justify-content-between align-items-center">
                                <small class="text-muted">Par {{ post.user.pseudo }} – le {{ post.createdAt|date('d/m/Y H:i') }}</small>
                                <a href="{{ path('app_post_show', { id: post.id }) }}" class="btn btn-sm btn-primary">Lire</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        {% else %}
            <div class="alert alert-info">Aucun post à afficher pour le moment.</div>
        {% endif %}
    </div>
{% endblock %}
