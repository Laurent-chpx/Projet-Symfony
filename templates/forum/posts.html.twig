{% extends 'base.html.twig' %}

{% block title %}Test{% endblock %}

{% block body %}
    <div class="container">

        <div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
            {% for post in posts %}
            <div class="col-lg-12 px-0"><h1 class="display-4 fst-italic">{{ post.title }}</h1>
                <p class="lead my-3">{{ post.content }}</p>
            </div>
            <p class="mb-2 text-muted">
                Par <strong>{{ post.user.pseudo }}</strong> —
                le {{ post.createdAt|date('d/m/Y H:i') }}
            </p>
        </div>

        {% for comment in post.comments %}
            <div class="p-4 p-md-5 mb-4 rounded text-body-emphasis bg-body-secondary">
            <p class="mb-2 text-muted">
                Par <strong>{{ comment.user.pseudo }}</strong> —
                le {{ comment.createdAt|date('d/m/Y H:i') }}
            </p>
            <p class="mb-2 text-muted">
                {{ comment.content }}
            </p>
            {% for file in comment.files %}
                <i class="bi bi-file-earmark-pdf-fill text-danger ms-2"></i>
                <a href="{{ asset('uploads/' ~ file.nameHashed) }}" target="_blank">
                    {{ file.nameOriginal }}
                </a><br />
            {% endfor %}
                </div>
        {% endfor %}

        <div class="comment-form">
            <h3>Ajouter un commentaire</h3>
            {{ form_start(form) }}

            {{ form_errors(form) }}

            {{ form_widget(form) }}

            <button type="submit" class="btn btn-primary">Commenter</button>

            {{ form_end(form) }}
        </div>
        {% endfor %}
    </div>

{% endblock %}
