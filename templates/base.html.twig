<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="../assets/styles/app.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>

    <div class="sidebar d-flex flex-column p-3 border-end">
        <h4 class="mb-4">Mon Intranet</h4>
        <ul class="nav nav-pills flex-column">
            <li class="nav-item">
                <a href="{{ path('app_home') }}" class="nav-link nav-title">🏠 Accueil</a>
            </li>
            <li class="nav-item">
                <a class="nav-link nav-title d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#categoriesMenu" role="button" aria-expanded="false" aria-controls="categoriesMenu">
                    📂 Catégories
                    <i class="bi bi-chevron-down" style="width: 1rem; height: 1rem; color: black;"></i>
                </a>
                <div class="collapse ps-3" id="categoriesMenu">
                    <ul class="nav flex-column">
                        {% for category in categories %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_categories', { id: category.id }) }}">{{ category.name }}</a>
                            </li>
                        {% else %}
                            <li class="nav-item text-muted">Aucune catégorie</li>
                        {% endfor %}
                    </ul>
                </div>
            </li>

            <li class="nav-item"><a class="nav-link nav-title" href="{{ path('user_profile') }}">👤 Mon compte</a></li>
            <li class="nav-item"><a class="nav-link nav-title" href="{{ path('user_posts') }}">📝 Mes publications</a></li>
            <li class="nav-item"><a class="nav-link nav-title" href="{{ path('user_comments') }}">✉️ Mes messages</a></li>

            {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a  class="nav-title d-flex justify-content-between align-items-center nav-link text-danger nav-title"
                        data-bs-toggle="collapse" href="#adminMenu" role="button" aria-expanded="false" aria-controls="adminMenu">
                        ⚙️ Panneau admin
                        <i class="bi bi-chevron-down" style="width: 1rem; height: 1rem; color: black;"></i>
                    </a>
                </li>
                 <div class="collapse ps-3" id="adminMenu">
                    <ul class="nav flex-column">
                        <li class="nav-item"> <a class="nav-link" href="{{ path('admin_users') }}">👤 Utilisateurs</a> </li>
                        <li class="nav-item"> <a class="nav-link" href="{{ path('admin_categories') }}">📂 Catégories</a> </li>
                        <li class="nav-item"> <a class="nav-link" href="{{ path('admin_boards') }}">📝 Boards</a> </li>
                    </ul>
                 </div>
            {% endif %}
            <li class="nav-item mt-3">
                {% if app.user %}
                    <a class="nav-link nav-title" href="{{ path('app_logout') }}">🔓 Déconnexion</a>
                {% else %}
                    <a class="nav-link nav-title" href="{{ path('app_login') }}">🔐 Connexion</a>
                {% endif %}
            </li>
        </ul>
    </div>

    {% block body %}
        {% endblock %}
    </body>
</html>
