{% extends 'base.html.twig' %}

{% block title %}Gestion des catégories{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">
                    Gestion des catégories
                </h1>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Liste des catégories ({{ categoriesWithPermissions|length }})</h5>
                    </div>
                    <div class="card-body p-0">
                        {% if categoriesWithPermissions|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Nom</th>
                                        <th>Nombre de boards</th>
                                        <th>Rôles autorisés</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for item in categoriesWithPermissions %}
                                        {% set category = item.category %}
                                        {% set permissions = item.permissions %}
                                        <tr>
                                            <td><strong>{{ category.name }}</strong></td>
                                            <td>
                                                    <span class="badge bg-info">
                                                        {{ category.boards|length }} boards
                                                    </span>
                                            </td>
                                            <td>
                                                {% if item.roleNames|length > 0 %}
                                                    {% for roleName in item.roleNames %}
                                                        <span class="badge bg-primary me-1">{{ roleName }}</span>
                                                    {% endfor %}
                                                {% else %}
                                                    <span class="badge bg-warning">Aucun rôle défini</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('admin_category_edit', {id: category.id}) }}"  class="btn btn-sm btn-outline-primary">
                                                        Modifier
                                                    </a>

                                                    <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_category' ~ category.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.')">
                                                            Supprimer
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
