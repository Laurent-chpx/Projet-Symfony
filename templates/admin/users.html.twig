{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-4">
                    Gestion des utilisateurs
                </h1>

                <div class="mb-3">
                    <a href="{{ path('app_admin') }}" class="btn btn-secondary">
                        Retour à l'administration
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Liste des utilisateurs ({{ users|length }})</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th>Pseudo</th>
                                    <th>Email</th>
                                    <th>Rôle actuel</th>
                                    <th>Nouveau rôle</th>
                                    <th>Statut</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for user in users %}
                                    <tr class="{{ user.blocked ? 'table-danger' : '' }}">
                                        <td>
                                            <strong>{{ user.pseudo }}</strong>
                                            {% if user.id == app.user.id %}
                                                <span class="badge bg-info ms-2">Vous</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ user.email }}</td>
                                        <td>
                                            <span class="badge bg-primary">{{ user.idRole.name }}</span>
                                        </td>
                                        <td>
                                            {% if user.id != app.user.id %}
                                                <form method="post" action="{{ path('admin_user_change_role', {id: user.id}) }}" class="d-inline">
                                                    <div class="input-group input-group-sm">
                                                        <select name="role_id" class="form-select form-select-sm" style="max-width: 150px;">
                                                            <option value="">Choisir...</option>
                                                            <option value="1" {{ user.idRole and user.idRole.id == 1 ? 'selected' : '' }}>Insider</option>
                                                            <option value="2" {{ user.idRole and user.idRole.id == 2 ? 'selected' : '' }}>Collaborator</option>
                                                            <option value="3" {{ user.idRole and user.idRole.id == 3 ? 'selected' : '' }}>External</option>
                                                            <option value="4" {{ user.idRole and user.idRole.id == 4 ? 'selected' : '' }}>Admin</option>
                                                        </select>
                                                        <button type="submit" class="btn btn-outline-primary btn-sm">
                                                            Ok
                                                        </button>
                                                    </div>
                                                    <input type="hidden" name="_token" value="{{ csrf_token('change_role' ~ user.id) }}">
                                                </form>
                                            {% else %}
                                                <span class="text-muted small">Non modifiable</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if user.blocked %}
                                                <span class="badge bg-danger">
                                                        Bloqué
                                                    </span>
                                            {% else %}
                                                <span class="badge bg-success">
                                                        Actif
                                                    </span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <!-- Bouton bloquer/débloquer -->
                                                {% if user.id != app.user.id %}
                                                    <form method="post" action="{{ path('admin_user_toggle_block', {id: user.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_block' ~ user.id) }}">
                                                        <button type="submit" class="btn btn-sm {{ user.blocked ? 'btn-success' : 'btn-warning' }}" onclick="return confirm('Êtes-vous sûr de vouloir {{ user.blocked ? 'débloquer' : 'bloquer' }} cet utilisateur ?')">
                                                            {{ user.blocked ? 'Débloquer' : 'Bloquer' }}
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <p class="text-muted">Aucun utilisateur trouvé.</p>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
